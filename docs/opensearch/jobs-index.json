      "NocJobTitle": {"type": "text", "fields": {"exact": {"type": "text", "analyzer": "english_exact"}, "keyword": {"type": "keyword", "ignore_above": 256}, "normalize": {"type": "keyword", "normalizer": "lowercase_normalizer"}}},
      "Occupation": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "PeriodOfEmployment": {"properties": {"Description": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}},
      "PositionsAvailable": {"type": "long"},
      "PostalCode": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ProgramDescription": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ProgramName": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "Province": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "Region": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "Salary": {"type": "float"},
      "SalaryConditions": {"properties": {"Description": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}},
      "SalaryDescription": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "SalarySort": {"properties": {"Ascending": {"type": "float"}, "Descending": {"type": "float"}}},
      "SalarySummary": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "SkillCategories": {"type": "nested", "properties": {"Category": {"properties": {"Id": {"type": "long"}, "Name": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}}, "SkillCount": {"type": "long"}, "Skills": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}, "copy_to": ["AllSkills"]}}},
      "StartDate": {"type": "date"},
      "Title": {"type": "text", "fields": {"exact": {"type": "text", "analyzer": "english_exact"}, "keyword": {"type": "keyword", "ignore_above": 256}, "normalize": {"type": "keyword", "normalizer": "lowercase_normalizer"}}},
      "WageClass": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "WorkHours": {"type": "float"},
      "WorkLangCd": {"properties": {"Description": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}},
      "WorkplaceType": {"properties": {"Description": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}, "Id": {"type": "long"}}}
    }
  }
}
