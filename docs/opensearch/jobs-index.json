      "ApplyMailProvince": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyMailRoom": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyMailStreet": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonCity": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonPostalCode": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonProvince": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonRoom": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonStreet": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonTimeFrom": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPersonTimeTo": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPhoneNumber": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPhoneNumberExt": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPhoneNumberTimeFrom": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyPhoneNumberTimeTo": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "ApplyWebsite": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "City": {"type": "text", "fields": {"exact": {"type": "text", "analyzer": "english_exact"}, "keyword": {"type": "keyword", "ignore_above": 256}, "normalize": {"type": "keyword", "normalizer": "lowercase_normalizer"}}},
      "DatePosted": {"type": "date"},
      "EduLevel": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
      "EmployerName": {"type": "text", "fields": {"exact": {"type": "text", "analyzer": "english_exact"}, "keyword": {"type": "keyword", "ignore_above": 256}, "normalize": {"type": "keyword", "normalizer": "lowercase_normalizer"}}},
      "EmployerTypeId": {"type": "long"},
      "EmploymentTerms": {"properties": {"Description": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}},
      "ExpireDate": {"type": "date"},
      "ExternalSource": {"type": "nested", "properties": {"Source": {"properties": {"Source": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}, "Url": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}}}}}},
      "Function": {"type": "text", "fields": {"keyword": {"type": "keyword", "ignore_above": 256}}},
